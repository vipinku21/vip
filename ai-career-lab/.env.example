# Local settings. Restart the backend after edits.
LAB_TIMEZONE=Asia/Kolkata
LAB_PILOT_LIMIT=20
# Hosted only: HTTPS address for the app and a random owner setup key of 32+ characters.
# LAB_PUBLIC_ORIGIN=https://your-account.alwaysdata.net
# LAB_ADMIN_SETUP_TOKEN=generate-privately-on-the-host
# LAB_DATABASE_URL=sqlite:///C:/path/to/learning.db
QUESTION_PROVIDER=off
# Set to stackexchange to retrieve recent Stack Overflow questions.
STACKEXCHANGE_KEY=
# Optional chat-completions compatible service. Use HTTPS for remote providers.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

